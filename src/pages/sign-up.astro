---
import AuthForm from '@/components/AuthForm';
import FullPageLayout from '@/layouts/FullPageLayout.astro';
import { getSafeCallbackURL } from '@/lib/auth-redirect';

if (process.env.ALLOW_SIGNUP !== 'true') {
  return new Response('Not found', { status: 404 });
}

const callbackURL = getSafeCallbackURL(Astro.url.searchParams.get('callbackURL'));

if (Astro.locals.user) {
  return Astro.redirect(callbackURL);
}
---

<FullPageLayout currentPage="sign-up" title="Create an OpenPoll account">
  <section class="flex min-h-screen items-center justify-center bg-gradient-to-br from-blue-50 via-white to-purple-50 px-4 py-12">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <h1 class="mb-3 text-4xl font-bold text-gray-900">Create your account</h1>
        <p class="text-gray-600">Register with an email address and password.</p>
      </div>
      <AuthForm
        client:load
        mode="sign-up"
        callbackURL={callbackURL}
        allowSignUp={true}
        githubEnabled={false}
      />
    </div>
  </section>
</FullPageLayout>
